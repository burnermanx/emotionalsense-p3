# Computes the version strings and writes version.h, but only when they
# change. Runs at configure time and again on every build, so a new commit or
# tag never leaves a stale string in the binary.
#
#   cmake -DSRC=<source dir> -DOUT=<version.h> -DVERSION=<project version>
#         [-DSUFFIX=-dev] -P cmake/version.cmake

set(VERSION "${VERSION}${SUFFIX}")
set(full "${VERSION}")
set(base "${VERSION}")
if(SUFFIX)
    string(REPLACE "${SUFFIX}" "" base "${VERSION}")
endif()
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE AND EXISTS "${SRC}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" describe --tags --dirty
        WORKING_DIRECTORY "${SRC}"
        OUTPUT_VARIABLE describe OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET RESULT_VARIABLE rc)
    # A development tree whose version is ahead of the last tag (0.2.0-dev after v0.1.0) is
    # described from its own version, not from the old tag.
    if(rc EQUAL 0 AND describe AND describe MATCHES "^v?${base}")
        string(REGEX REPLACE "^v" "" describe "${describe}")
        set(full "${describe}")
    else()
        # No tag yet: the same shape git describe would give, counted from the
        # CMake version instead of the nearest tag.
        execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
            WORKING_DIRECTORY "${SRC}"
            OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
            WORKING_DIRECTORY "${SRC}"
            OUTPUT_VARIABLE count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain
            --untracked-files=no
            WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE dirty ERROR_QUIET)
        set(full "${VERSION}-${count}-g${head}")
        if(dirty)
            string(APPEND full "-dirty")
        endif()
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${SRC}/psprecomp"
        OUTPUT_VARIABLE psprecomp OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(NOT psprecomp)
    set(psprecomp "unknown")   # a source tarball has no submodule history
endif()

set(content "/* Generated by cmake/version.cmake. Do not edit. */
#ifndef EMOTIONALSENSE_VERSION_H
#define EMOTIONALSENSE_VERSION_H

/* project(VERSION ...) -- what a release is named after. */
#define EMOTIONALSENSE_VERSION      \"${VERSION}\"

/* git describe --tags --dirty, or the CMake version when there is no .git. */
#define EMOTIONALSENSE_VERSION_FULL \"${full}\"

/* Pinned psprecomp commit, so a bug report says which toolkit built it. */
#define EMOTIONALSENSE_PSPRECOMP    \"${psprecomp}\"

#endif
")

if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
