# ---------------------------------------------------------------------------
# COPYRIGHTED GAME DATA -- NEVER COMMIT.
# Disc images, anything extracted or decrypted from them, and anything
# generated from the game's code (the recompiled C and the binaries built
# from it) are derived from your own copy of the game and stay local.
# ---------------------------------------------------------------------------
*.iso
*.ISO
*.cso
*.CSO
*.pbp
*.PBP
*.BIN
*.bin
*.elf
*.prx
*.PRX
*.TPA
*.tpa
*.SFO
*.sfo

# Pipeline output: extracted disc, decrypted modules, generated C, builds.
/work/
/build/
/build-*/
/dist/
*.AppImage
*.zsync

# PSP key material, if anyone ever drops it in here.
keys/
psp_keys.txt

# Editors / Python
__pycache__/
*.pyc
.vscode/
.idea/
*.swp

# Launcher build output (fonts subset, rendered theme): regenerated by
# launcher/assets/build_assets.py, never committed.
/launcher/assets/generated/
/launcher/assets/.cache/
/kit/
/kit-*/
/launcher/__pycache__/
/launcher/tests/__pycache__/

# Portable data folder of a source checkout (launcher/es_portable.py)
/EmotionalSense-P3-data/
